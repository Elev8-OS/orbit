# ─────────────────────────────────────────────────────────────
# oauth2-proxy vor einem Legacy-Tool ohne eigenen Login
# Railway-Service aus Image: quay.io/oauth2-proxy/oauth2-proxy:v7.12.0
# (Version vor dem Einsatz auf https://github.com/oauth2-proxy/oauth2-proxy/releases prüfen)
# ─────────────────────────────────────────────────────────────

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OAUTH2_PROXY_CLIENT_ID=<Client-ID der Orbit-App-Registrierung>
OAUTH2_PROXY_CLIENT_SECRET=<Client-Secret>
OAUTH2_PROXY_REDIRECT_URL=https://<proxy-domain>/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile

# Erzeugen mit: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_NAME=_orbit_proxy

# Die App Roles aus dem Token als "Gruppen" behandeln und darauf prüfen
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=roles
OAUTH2_PROXY_ALLOWED_GROUPS=App.Reports,Orbit.Admin

# Entra liefert kein email_verified; preferred_username dient als User-Kennung
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=preferred_username
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true

# Direkt zu Microsoft weiterleiten, ohne Zwischenseite
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180

# Das eigentliche Tool über Railways privates Netzwerk – ohne öffentliche Domain!
OAUTH2_PROXY_UPSTREAMS=http://legacy-reports.railway.internal:8080
# Name und E-Mail an das Tool weitergeben (Header X-Forwarded-User / -Email)
OAUTH2_PROXY_PASS_USER_HEADERS=true
