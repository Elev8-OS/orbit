# ── Auth.js ───────────────────────────────────────────────
# Erzeugen mit: npx auth secret   (oder: openssl rand -base64 33)
AUTH_SECRET=
# Auf Railway nötig, da die App hinter einem Proxy läuft
AUTH_TRUST_HOST=true
# Öffentliche URL von Orbit (lokal: http://localhost:3000)
AUTH_URL=http://localhost:3000

# ── Microsoft Entra ID (App-Registrierung "Orbit") ────────
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Mandantenspezifischer Issuer, damit nur dein Tenant (inkl. B2B-Gäste) rein darf
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# ── Datenbank (Railway Postgres: ${{Postgres.DATABASE_URL}}) ─
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orbit

# ── Orbit ─────────────────────────────────────────────────
# App Role, die alle Kacheln sieht
ORBIT_ADMIN_ROLE=Orbit.Admin
# Sprache, wenn weder Cookie, Profil noch Browser etwas vorgeben (de | en)
ORBIT_DEFAULT_LOCALE=de
# Wird im leeren Dashboard als Kontakt angezeigt (optional)
ORBIT_SUPPORT_EMAIL=it@example.com
# Pfad zur App-Registry (optional, Standard: config/apps.yaml)
APPS_CONFIG_PATH=config/apps.yaml

# ── E-Mail über Resend ────────────────────────────────────
# API-Key aus https://resend.com/api-keys (Berechtigung: Sending access)
RESEND_API_KEY=
# Absender auf einer in Resend verifizierten Domain
MAIL_FROM=Orbit <orbit@mail.example.com>
# Empfänger von Zugriffsanfragen (kommagetrennt)
ORBIT_ACCESS_REQUEST_TO=it@example.com
# Willkommensmail beim ersten Login (true | false)
ORBIT_WELCOME_EMAIL=true

# ── Offerten-App (/offerten) ──────────────────────────────
# Rollen (Entra App Roles). Standard: App.Offerten und App.Offerten.Admin
# OFFERTEN_ROLE=App.Offerten
# OFFERTEN_ADMIN_ROLE=App.Offerten.Admin
# Teilnehmer dieser Domains gelten als intern, nicht als Interessenten
OFFERTEN_INTERNAL_DOMAINS=elev8-suite.com,elevater.ch

# Fireflies: API-Key (Settings → Developer settings) und Webhook-Secret (frei wählen, in Fireflies gleich eintragen)
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# Claude für die Call-Analyse
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# GoHighLevel: Private Integration Token der Location
# Scopes: contacts.readonly, contacts.write, opportunities.readonly, opportunities.write,
#         locations/customFields.readonly, medias.write
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Stufe, auf die die Opportunity nach dem Versand gesetzt wird
GHL_PROPOSAL_STAGE_NAME=Proposal / Contract Sent
# Optional: Kontaktfeld vom Typ Datei für die Offerte (fieldKey, z.B. contact.letzte_offerte)
GHL_QUOTE_FILE_FIELD_KEY=
# Opportunity-Wert auf das Total im ersten Jahr setzen (true | false)
GHL_SET_OPPORTUNITY_VALUE=true

# Versand: graph = aus dem Postfach des angemeldeten Users (Entra-App braucht Mail.Send als Anwendungsberechtigung)
#          resend = über Resend mit OFFERTEN_MAIL_FROM, Antworten gehen an den User
OFFERTEN_MAIL_PROVIDER=graph
# OFFERTEN_MAIL_FROM=Elev8 <offers@elev8-suite.com>
